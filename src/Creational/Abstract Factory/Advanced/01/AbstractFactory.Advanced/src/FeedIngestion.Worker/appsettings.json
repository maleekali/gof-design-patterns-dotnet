{
  "Broker": {
    "Provider": "RabbitMQ"
  },
  "Redis": {
    "ConnectionString": "localhost:6379"
  },
  "RabbitMq": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "guest",
    "Password": "guest",
    "Exchange": "feed.events",
    "OrdersRoutingKey": "orders.imported",
    "FailureRoutingKey": "feed.failures",
    "FailureQueue": "feed.failures",
    "OrdersQueue": "feed.orders"
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "ClientId": "feed-ingestion-worker",
    "OrdersTopic": "feed.order-imported",
    "FailureTopic": "feed.failures"
  },
  "Feed": {
    "IncomingDirectory": "data/incoming",
    "ProcessedDirectory": "data/processed",
    "PollIntervalSeconds": 5,
    "LeaseSeconds": 300,
    "RecordMarkerDays": 30,
    "CompletedFileDays": 30
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "FileSource": {
    "Provider": "Directory"
  },
  "Sftp": {
    "Host": "localhost",
    "Port": 22,
    "UserName": "feeduser",
    "Password": "change-me",
    "IncomingDirectory": "/home/feeduser/upload",
    "ProcessedDirectory": "/home/feeduser/processed",
    "LocalSpoolDirectory": "data/sftp-spool"
  }
}
